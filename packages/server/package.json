{
  "name": "@hanabi/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit push:pg",
    "db:seed": "tsx src/db/seeds/run.ts",
    "db:sync-variants": "tsx src/jobs/syncVariants.ts"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/cookie": "^9.3.0",
    "@fastify/session": "^10.8.0",
    "drizzle-orm": "^0.30.0",
    "postgres": "^3.4.0",
    "node-cron": "^3.0.3",
    "@hanabi/dsl": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
